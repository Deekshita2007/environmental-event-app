rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function ownsProfile() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validProfile() {
        return request.resource.data.keys().hasOnly([
                 'name',
                 'email',
                 'isAdmin',
                 'phoneNumber',
                 'location',
                 'profileImagePath'
               ])
            && request.resource.data.keys().hasAll([
                 'name',
                 'email',
                 'isAdmin',
                 'phoneNumber',
                 'location',
                 'profileImagePath'
               ])
            && request.resource.data.name is string
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.isAdmin
                == (request.auth.token.email == 'admin@ecoconnect.com')
            && request.resource.data.phoneNumber is string
            && request.resource.data.location is string
            && (
              request.resource.data.profileImagePath == null
              || request.resource.data.profileImagePath is string
            );
      }

      allow get: if ownsProfile();
      allow create, update: if ownsProfile() && validProfile();
    }
  }
}
